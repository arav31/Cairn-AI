OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini

# To use NVIDIA Nemotron instead of OpenAI Responses:
# SKILL_BUILDER_LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_TEMPERATURE=1
# NVIDIA_TOP_P=0.95
# NVIDIA_MAX_TOKENS=16384
# NVIDIA_ENABLE_THINKING=1
# NVIDIA_REASONING_BUDGET=16384
# SKILL_BUILDER_LLM=off
# SKILL_BUILDER_LLM_REQUIRED=1
# SKILL_BUILDER_LLM_TIMEOUT_MS=30000
