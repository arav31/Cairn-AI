# Recommended: use local Codex CLI as the endpoint-engineering reviewer.
# This uses your existing Codex login or CODEX_API_KEY auth.
SKILL_BUILDER_LLM_PROVIDER=codex
SKILL_BUILDER_CODEX_COMMAND=codex.cmd
SKILL_BUILDER_CODEX_MODEL=gpt-5.4
SKILL_BUILDER_CODEX_REQUIRED=1
SKILL_BUILDER_ANALYSIS_MIN_CONFIDENCE=0.65
# SKILL_BUILDER_CODEX_SANDBOX=read-only
# SKILL_BUILDER_CODEX_CWD=C:\Users\User\Documents\superai2

# Browser recording engine:
# auto = use Kuri when the vendored binary is available, then fall back to Chrome CDP.
# kuri = force Kuri; cdp = force the original Chrome DevTools recorder.
SKILL_BUILDER_BROWSER_ENGINE=auto
# SKILL_BUILDER_KURI_BIN=C:\path\to\kuri.exe
# SKILL_BUILDER_KURI_TIMEOUT_MS=30000
# SKILL_BUILDER_KURI_NAV_TIMEOUT_MS=45000

# Real Unbrowse route learning:
# auto = try a running local Unbrowse runtime, then CLI+Bun-managed runtime, then fallback.
# off = skip Unbrowse and use the local Kuri/Codex recorder only.
SKILL_BUILDER_UNBROWSE=auto
UNBROWSE_URL=http://localhost:6969
# Required by the npm-published Unbrowse runtime unless you already run a local server.
# UNBROWSE_BUN_BIN=C:\Users\User\.bun\bin\bun.exe
UNBROWSE_TOS_ACCEPTED=1
UNBROWSE_NON_INTERACTIVE=1
# Optional: allow remote SDK resolve/execute instead of local browser capture.
# This does not open local browser sessions; use local runtime for first-time workflow capture.
# SKILL_BUILDER_UNBROWSE_REMOTE=1
# UNBROWSE_API_KEY=ub-your-key-here
# UNBROWSE_BACKEND_URL=https://beta-api.unbrowse.ai

# To use OpenAI Chat Completions instead of Codex:
# SKILL_BUILDER_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5.4-mini

# To use NVIDIA Nemotron instead of Codex:
# SKILL_BUILDER_LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_TOKENS=4096
# OPENAI_TEMPERATURE=0.2
# OPENAI_REASONING_EFFORT=low
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_TEMPERATURE=0.2
# NVIDIA_TOP_P=0.9
# NVIDIA_MAX_TOKENS=3072
# NVIDIA_ENABLE_THINKING=0
# NVIDIA_REASONING_BUDGET=4096
# SKILL_BUILDER_LLM=off
# SKILL_BUILDER_LLM_REQUIRED=1
# SKILL_BUILDER_LLM_TIMEOUT_MS=30000
