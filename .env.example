# Cairn local development environment
#
# Copy this file to `.env` and replace the placeholder values.
# The app loads `.env` automatically when you run `npm start`.

# Server
PORT=3000
HOST=127.0.0.1
CAIRN_PUBLIC_URL=http://localhost:3000
CAIRN_AGENT_KEY=
CAIRN_ENABLE_DEMO_LISTINGS=false

# Stripe core
# Leave blank for local stub mode. Set real test/live keys to create Checkout Sessions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional per-listing Stripe Price IDs.
# Direct per-call prices are currently below Stripe's minimum charge, so tokens or
# aggregated metered billing are the better production path for tiny calls.
STRIPE_PRICE_INSURANCE_COMPARE=
STRIPE_PRICE_PROPERTY_SEARCH=

# Optional usage billing meter event name.
STRIPE_METER_EVENT_NAME=cairn_api_call

# Optional token pack Stripe Price IDs.
STRIPE_PRICE_TOKENS_STARTER=
STRIPE_PRICE_TOKENS_BUILDER=
STRIPE_PRICE_TOKENS_TEAM=

# Production AWS values for the next backend phase.
# The current demo does not read these yet, but these are the names to use when
# wiring persistent storage, worker queues, and artifact storage.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=3
RDS_DB_INSTANCE_IDENTIFIER=cairn-postgres-prod
RDS_DB_NAME=cairn
RDS_MASTER_USERNAME=cairn_admin
S3_RECORDINGS_BUCKET=
S3_API_ARTIFACTS_BUCKET=
S3_TRACES_BUCKET=
S3_SCREENSHOTS_BUCKET=
S3_VERIFICATION_BUCKET=
S3_REPAIR_BUCKET=
S3_RECORDINGS_PREFIX=recordings/
S3_REDACTED_RECORDINGS_PREFIX=redacted-recordings/
S3_TRACES_PREFIX=traces/
S3_SCREENSHOTS_PREFIX=screenshots/
S3_OPERATION_SPECS_PREFIX=operation-specs/
S3_OPENAPI_PREFIX=openapi/
S3_VERIFICATION_PREFIX=verification-runs/
S3_REPAIR_PREFIX=repair-jobs/
KMS_KEY_ARN=
SQS_RECORDING_QUEUE_URL=
SQS_SYNTHESIS_QUEUE_URL=
SQS_VERIFICATION_QUEUE_URL=
SQS_INVOCATION_QUEUE_URL=
SQS_REPAIR_QUEUE_URL=
EVENTBRIDGE_BUS_NAME=
SECRETS_PREFIX=/cairn/dev

# Repair/browser-agent adapters for later.
OPENAI_API_KEY=
BROWSER_USE_API_KEY=
