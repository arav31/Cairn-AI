{
  "name": "cairn",
  "version": "0.1.0",
  "private": false,
  "description": "Cairn turns a browser workflow into a durable, private, reusable API you and your agents own and call forever.",
  "keywords": [
    "workflow",
    "api",
    "automation",
    "agents",
    "mcp",
    "openapi",
    "private-api",
    "browser-automation",
    "record-and-reuse"
  ],
  "type": "commonjs",
  "main": "src/sdk/client.js",
  "exports": {
    ".": "./src/sdk/client.js",
    "./server": "./src/server.js"
  },
  "bin": {
    "cairn": "bin/cairn.js"
  },
  "files": [
    "api",
    "bin",
    "migrations",
    "public",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate-database.js",
    "test": "node --test tests/*.test.js",
    "video:studio": "npm --prefix video/cairn-explainer run studio",
    "video:still": "npm --prefix video/cairn-explainer run still",
    "video:render": "npm --prefix video/cairn-explainer run render",
    "video:voiceover": "npm --prefix video/cairn-explainer run generate-voiceover",
    "video:render:voiceover": "npm --prefix video/cairn-explainer run render:voiceover"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18"
  }
}
