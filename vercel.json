{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/cairn.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/marketplace",
      "dest": "/public/marketplace.html"
    },
    {
      "src": "/pricing",
      "dest": "/public/pricing.html"
    },
    {
      "src": "/\\.well-known/cairn\\.json",
      "dest": "/api/cairn?cairnPath=/.well-known/cairn.json"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/cairn?cairnPath=/openapi.json"
    },
    {
      "src": "/mcp",
      "dest": "/api/cairn?cairnPath=/mcp"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/cairn?cairnPath=/api/$1"
    },
    {
      "src": "/meridian",
      "dest": "/api/cairn?cairnPath=/meridian"
    },
    {
      "src": "/meridian/(.*)",
      "dest": "/api/cairn?cairnPath=/meridian/$1"
    },
    {
      "src": "/civic",
      "dest": "/api/cairn?cairnPath=/civic"
    },
    {
      "src": "/civic/(.*)",
      "dest": "/api/cairn?cairnPath=/civic/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
